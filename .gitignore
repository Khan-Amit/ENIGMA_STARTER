# ============================================
# 🎁 ENIGMA_STARTER - Complete Git Ignore File
# ============================================

# ============ DEPENDENCIES ==============
# Node modules (generated by npm/yarn)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============ ENVIRONMENT VARIABLES =====
# NEVER commit secret keys or environment variables!
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
.env.production
.env.staging

# ============ CRYPTO WALLET SECURITY =====
# EXTREMELY IMPORTANT: Never commit these!
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
secret*.json
mnemonic*.txt
keystore/
private-keys/
wallet-backups/
secrets/
credentials/

# ============ BUILD OUTPUTS =============
dist/
build/
.out/
.next/
.gatsby/
.cache/
public/bundle/
public/build/

# ============ IDE & EDITOR ==============
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db

# ============ OPERATING SYSTEM ==========
# macOS
.DS_Store
.AppleDouble
.LSOverride
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ============ TESTING ===================
coverage/
.nyc_output/
*.lcov
jest-coverage/
test-results/

# ============ LOGS ======================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ============ TEMPORARY FILES ===========
tmp/
temp/
*.tmp
*.temp
.cache/
.tmp/

# ============ DOCKER ====================
docker-compose.override.yml

# ============ MISC ======================
*.seed
*.pid
*.pid.lock
*.tgz
.yarn-integrity
.parcel-cache/
.vercel/
.serverless/
.fusebox/
.eslintcache
