{
  "name": "ENIGMA_STARTER - Gift Box Wallet",
  "short_name": "ENIGMA Wallet",
  "description": "A mysterious digital wallet that treats crypto assets like precious gifts waiting to be unwrapped",
  "version": "0.1.0",
  "manifest_version": 3,
  
  "action": {
    "default_popup": "index.html",
    "default_title": "ENIGMA Wallet",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "permissions": [
    "storage"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "images/*"],
      "matches": ["<all_urls>"]
    }
  ],
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'"
  },
  
  "author": "Novish Developer",
  "homepage_url": "https://khan-amit.github.io/ENIGMA_STARTER/",
  
  "externally_connectable": {
    "matches": ["*://localhost/*", "https://khan-amit.github.io/*"]
  },
  
  "minimum_chrome_version": "88",
  
  "offline_enabled": true,
  
  "incognito": "split",
  
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open ENIGMA Wallet"
    },
    "open_gift": {
      "suggested_key": {
        "default": "Ctrl+Shift+G",
        "mac": "Command+Shift+G"
      },
      "description": "Open a random gift"
    }
  },
  
  "options_page": "options.html",
  
  "sidebar_action": {
    "default_title": "ENIGMA Gift Box",
    "default_panel": "sidebar.html",
    "default_icon": "icons/icon48.png"
  },
  
  "theme": {
    "colors": {
      "frame": "#0f2027",
      "tab_background_text": "#ffffff",
      "tab_background_text_inactive": "#aaaaaa",
      "tab_background_text_selected": "#00ffff",
      "tab_text": "#f0f0f0",
      "tab_line": "#00ffff",
      "tab_loading": "#4ecdc4",
      "tab_selected": "#203a43",
      "tab_background": "#0f2027",
      "tab_border": "#2c5364",
      "tab_border_inactive": "#1a2b33",
      "tab_border_selected": "#00ffff",
      "button_background": "#0072ff",
      "button_background_hover": "#00c6ff",
      "button_background_active": "#0052cc",
      "button_text": "#ffffff",
      "toolbar": "#0f2027",
      "toolbar_text": "#f0f0f0",
      "toolbar_field": "#1a2b33",
      "toolbar_field_text": "#ffffff",
      "toolbar_field_border": "#2c5364",
      "toolbar_field_border_focus": "#00ffff",
      "toolbar_field_focus": "#1a2b33",
      "toolbar_field_separator": "#2c5364",
      "toolbar_top_separator": "#2c5364",
      "toolbar_vertical_separator": "#2c5364",
      "toolbar_bottom_separator": "#2c5364",
      "bookmark_text": "#f0f0f0",
      "ntp_background": "#0f2027",
      "ntp_text": "#f0f0f0",
      "ntp_link": "#00ffff",
      "ntp_link_underline": "#00ffff",
      "ntp_header": "#203a43",
      "ntp_section": "#1a2b33",
      "ntp_section_text": "#f0f0f0",
      "ntp_section_link": "#4ecdc4",
      "ntp_section_link_underline": "#4ecdc4",
      "sidebar": "#0f2027",
      "sidebar_border": "#2c5364",
      "sidebar_text": "#f0f0f0",
      "sidebar_highlight": "#203a43",
      "sidebar_highlight_text": "#00ffff",
      "popup": "#0f2027",
      "popup_text": "#f0f0f0",
      "popup_border": "#2c5364",
      "popup_highlight": "#203a43",
      "popup_highlight_text": "#00ffff"
    }
  },
  
  "declarative_net_request": {
    "rule_resources": []
  },
  
  "host_permissions": [
    "*://*/*"
  ],
  
  "oauth2": {
    "client_id": "enigma-wallet-client",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  
  "key": "
